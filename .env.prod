# 当前环境（可用于代码内判断环境）
APP_ENV=prod

# API 基地址（默认值，可被覆盖）
APP_API_URL=https://api.gvray.com
APP_API_TOKEN_KEY=token_key
APP_API_TIMEOUT=60000

# 功能开关（布尔值请用字符串）
# 本地模拟数据是否开启
APP_MOCK_ENABLED=false

# 默认语言
APP_DEFAULT_LANGUAGE=zh-CN

# 登录密码 AES 加密（key/iv 需与后端一致，16 字节）
APP_AES_KEY=0123456789abcdef
APP_AES_IV=abcdef0123456789
